   "source": [
    "def evenOdd(x):\n",
    "    if x % 2 == 0:\n",
    "        return 'Even'\n",
    "    return 'Odd'\n",
    "print(evenOdd(16))\n",
    "print(evenOdd(7))\n",
    "\n",
    "def sq_value(num):\n",
    "    return num ** 2\n",
    "print(sq_value(2))\n",
    "print(sq_value(-4))"
   ]
