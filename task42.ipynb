      "source": [
        "import pandas as pd\n",
        "\n",
        "mydataset = {\n",
        "    'cars': ['BMW', 'Volvo', 'Ford'],\n",
        "    'passings': [3, 7, 2]\n",
        "}\n",
        "myvar = pd.DataFrame(mydataset)\n",
        "print(myvar)\n"
      ],
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "cars  passings\n",
            "0    BMW         3\n",
